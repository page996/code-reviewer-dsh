#!/bin/sh
# dsh-code-reviewer - pre-commit hook
#
# Installed by:  node bin/review.mjs install-hooks
# Scope:        staged changes, deterministic gate commands only (fast, no LLM).
# Mode:         .review/config.json -> { "hooks": { "preCommit": "off|fast|full" } } (default fast)
# Bypass:       REVIEW_SKIP_HOOKS=1 git commit ...   (or: git commit --no-verify)
#
# This hook is a client-side fast net. GitHub Actions is the authoritative gate:
# the review workflow re-runs scope/plan/gate and the full LLM review on every pull request.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  # Not inside a git work tree (e.g. bare repository): nothing to review.
  exit 0
}

if ! command -v node >/dev/null 2>&1; then
  echo "dsh-code-review: pre-commit hook skipped: 'node' was not found on PATH" >&2
  exit 0
fi

if [ ! -f "$ROOT/bin/review.mjs" ]; then
  echo "dsh-code-review: pre-commit hook skipped: $ROOT/bin/review.mjs not found" >&2
  exit 0
fi

cd "$ROOT" || exit 0
exec node "$ROOT/bin/review.mjs" hook pre-commit
